# Server
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"

# Email provider: "ses" or "nodemailer"
MAIL_PROVIDER="ses"

# Nodemailer Primary mail account
MAIL_HOST="gmail"
MAIL_USER="your-email@example.com"
MAIL_PASS="your-app-password"

# Secondary mail account used for OTP and password-reset emails
MAIL_HOST1="gmail"
MAIL_USER1="your-secondary-email@example.com"
MAIL_PASS1="your-secondary-app-password"

# AWS
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# AWS SES verified sender
SES_FROM_EMAIL="email@example.com"

# AWS S3
S3_BUCKET_NAME="your-s3-bucket-name"

# S3 object-key folders
FOLDER_NAME_COMPLAINTS="complaints"
FOLDER_NAME_FEE_RECEIPTS="fee-receipts"
FOLDER_NAME_ANNOUCEMENTS="announcements"
FOLDER_NAME_PROFILE_IMAGES="profile-images"
FOLDER_NAME_EXTRAS="extras"
FOLDER_NAME_ACKNOWLEDGEMENT_LETTERS="acknowledgement-letters"

# Optional legacy Cloudinary configuration (currently disabled in index.js)
CLOUD_NAME="your-cloudinary-cloud-name"
API_KEY="your-cloudinary-api-key"
API_SECRET="your-cloudinary-api-secret"

# Optional legacy Cloudinary folders (only referenced by disabled upload code)
FOLDER_NAME_IMAGES="images"
FOLDER_NAME_DOCS="documents"
